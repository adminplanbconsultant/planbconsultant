NEXT_PUBLIC_SITE_URL=https://planbconsultant.com
NEXT_PUBLIC_PHONE=+965 6614 9059
NEXT_PUBLIC_WHATSAPP=96566149059
NEXT_PUBLIC_EMAIL=info@planbconsultant.com
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_HOURS=
# Public HTTPS profile URLs. Leave blank until the business confirms each profile.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/planbconsultant_/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61592427068993
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@planbconsultant?lang=en-GB
# Optional GA4 measurement ID (G-XXXXXXXX). Leave blank to run with no analytics. Loads only when indexing is enabled; sends only event names/language/step, never personal data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# PHONE: international format, e.g. +965 followed by the confirmed number.
# WHATSAPP: country code and number, digits only; no +, spaces or URL.
# EMAIL: a monitored business mailbox. ADDRESS/HOURS: confirmed public wording.
# NEXT_PUBLIC_* values are public and compiled into the browser bundle.
# Rebuild after changing public values. Never put credentials in them.
# Keep false while reviewing. Enable only after company details and content approval.
NEXT_PUBLIC_ALLOW_INDEXING=false
# --- Enquiry storage: private Google Sheet via Google Apps Script (see GOOGLE-SHEET-SETUP.md) ---
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit real values.
# The Apps Script web-app URL ending in /exec.
GOOGLE_APPS_SCRIPT_URL=
# Long random string (at least 32 characters). Must equal SHARED_SECRET in the Apps Script's Script Properties.
GOOGLE_APPS_SCRIPT_SECRET=

# --- Optional but recommended spam protection: Cloudflare Turnstile (free) ---
# Site key is public by design; the secret key is server-only. Leave both blank to disable the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
