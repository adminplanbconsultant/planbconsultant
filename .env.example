NEXT_PUBLIC_SITE_URL=https://planbconsultant.com
NEXT_PUBLIC_PHONE=+965 6614 9059
NEXT_PUBLIC_WHATSAPP=96566149059
NEXT_PUBLIC_EMAIL=info@planbconsultant.com
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_HOURS=
# Public HTTPS profile URLs. Leave blank until the business confirms each profile.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/planbconsultant_/
NEXT_PUBLIC_FACEBOOK_URL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# PHONE: international format, e.g. +965 followed by the confirmed number.
# WHATSAPP: country code and number, digits only; no +, spaces or URL.
# EMAIL: a monitored business mailbox. ADDRESS/HOURS: confirmed public wording.
# NEXT_PUBLIC_* values are public and compiled into the browser bundle.
# Rebuild after changing public values. Never put credentials in them.
# Keep false while reviewing. Enable only after company details and content approval.
NEXT_PUBLIC_ALLOW_INDEXING=false
# PostgreSQL connection string; use your provider's pooled URL with TLS enabled.
DATABASE_URL=
# Generate a long random secret, at least 32 characters.
RATE_LIMIT_SECRET=

# Optional server-only notification integration. Use a trusted HTTPS endpoint.
# Optional: Google Apps Script /exec URL and its WEBHOOK_SECRET (see GOOGLE-SHEET-SETUP.md).
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
